{
  "name": "oficio-diario-lecionario",
  "private": true,
  "version": "1.0.0",
  "description": "Ofício Diário & Lecionário — Rede Episcopal Brasileira (PWA offline)",
  "type": "module",
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "verify": "npm run verify:calendar && npm run verify:lectionary && npm run verify:render",
    "verify:calendar": "node scripts/verify-calendar.mjs",
    "verify:lectionary": "node scripts/verify-lectionary.mjs",
    "verify:render": "node scripts/verify-render.mjs",
    "generate:data": "python3 scripts/generate-data.py",
    "generate:icons": "python3 scripts/generate-icons.py"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  }
}
